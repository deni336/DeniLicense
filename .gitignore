# Go build outputs
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Test, benchmark, fuzz, and profiling artifacts
/coverage/
coverage.out
*.coverprofile
*.prof
**/testdata/fuzz/*
!**/testdata/fuzz/.gitkeep

# Go workspaces and local module state
go.work
go.work.sum
/vendor/

# Local configuration and secrets
.env
.env.*
!.env.example
/secrets/
*.key.json

# Generated license artifacts contain credentials or signed grants
*.dlicense
*.dlic
*.dlim
*.dreq

# Local runtime data
/data/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
