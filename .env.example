# Development-only example. Generate new secrets; never reuse these values.
DENILICENSE_ENV=development
DENILICENSE_HTTP_ADDRESS=:8080
DENILICENSE_DATABASE_URL=postgres://denilicense:denilicense-development-only@localhost:5432/denilicense?sslmode=disable

# Each value is a different, independently generated unpadded base64url secret
# of at least 32 bytes. Generate each one separately with: denilic secret
DENILICENSE_TOKEN_PEPPER=REPLACE_WITH_BASE64URL_32_BYTE_SECRET
DENILICENSE_DEVICE_PEPPER=REPLACE_WITH_DIFFERENT_BASE64URL_32_BYTE_SECRET
# Recovery-critical: back this up securely and do not rotate it in place. It
# deterministically reconstructs retry-safe online claim codes.
DENILICENSE_ISSUANCE_PEPPER=REPLACE_WITH_THIRD_BASE64URL_32_BYTE_SECRET
# Optional; rotating it requires a password rehash migration strategy.
# DENILICENSE_PASSWORD_PEPPER=REPLACE_WITH_ANOTHER_BASE64URL_SECRET

DENILICENSE_REGISTRATION_MODE=open
DENILICENSE_EXPOSE_DEV_TOKENS=true
DENILICENSE_ALLOWED_ORIGINS=http://localhost:3000
# Only proxies in these networks may supply X-Forwarded-For.
# DENILICENSE_TRUSTED_PROXY_CIDRS=10.0.0.0/8,fd00::/8
DENILICENSE_ACCESS_TOKEN_TTL=15m
DENILICENSE_REFRESH_TOKEN_TTL=720h
DENILICENSE_ACTIVATION_LEASE_TTL=24h
# Development/test default true; production default false so the runtime role
# can remain DDL-free after a separate `denilicense migrate` job.
# DENILICENSE_AUTO_MIGRATE=true

# Generate this separate online signing key with:
#   denilic keygen --purpose activation --private secrets/activation.key.json --public secrets/activation.public.json
# DENILICENSE_ACTIVATION_ISSUER=https://licenses.example.com
# DENILICENSE_ACTIVATION_KEY_FILE=secrets/activation.key.json
# DENILICENSE_ACTIVATION_KEY_PASSPHRASE_FILE=secrets/activation.passphrase
# Comma-separated activation public-key documents for a prepublished successor
# and prior keys retained until every lease they signed has expired.
# DENILICENSE_ACTIVATION_VERIFICATION_KEY_FILES=secrets/activation.previous.public.json

# Production open registration: send a short-lived verification link to your
# email provider through a private HTTPS webhook. The token is never stored raw.
# DENILICENSE_PUBLIC_APP_URL=https://licenses.example.com
# DENILICENSE_EMAIL_WEBHOOK_URL=https://mailer.internal.example/v1/send
# DENILICENSE_EMAIL_WEBHOOK_BEARER=REPLACE_WITH_A_LONG_INDEPENDENT_SECRET
