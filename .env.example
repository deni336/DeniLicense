# Development template only. The application does not load this file
# automatically. Replace every placeholder and inject the values with your
# process manager, container platform, or secret manager.
DENILICENSE_ENV=development
DENILICENSE_HTTP_ADDRESS=:8080
DENILICENSE_DATABASE_URL=postgresql://denilicense:denilicense-development-only@localhost:5432/denilicense?sslmode=disable

# Generate each pepper independently with `denilic secret`. Values must be
# unpadded base64url and decode to at least 32 bytes; production startup rejects
# a value reused for more than one purpose.
DENILICENSE_TOKEN_PEPPER=REPLACE_WITH_INDEPENDENT_BASE64URL_SECRET
DENILICENSE_DEVICE_PEPPER=REPLACE_WITH_DIFFERENT_BASE64URL_SECRET

# Recovery-critical: back this up securely and do not rotate it in place.
# Retry-safe online license responses are deterministically derived from it.
DENILICENSE_ISSUANCE_PEPPER=REPLACE_WITH_THIRD_BASE64URL_SECRET

# Optional. Rotation requires a deliberate password-rehash strategy.
# DENILICENSE_PASSWORD_PEPPER=REPLACE_WITH_FOURTH_BASE64URL_SECRET

# Account lifecycle. Production cannot expose raw verification/reset tokens.
DENILICENSE_REGISTRATION_MODE=open
DENILICENSE_EXPOSE_DEV_TOKENS=true

# Comma-separated exact browser origins; no wildcard support. Include the
# public origin that serves the embedded /ui/ console.
DENILICENSE_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://localhost:3000

# Only configure networks belonging to proxies that overwrite X-Forwarded-For.
# DENILICENSE_TRUSTED_PROXY_CIDRS=10.0.0.0/8,fd00::/8

# Durations concatenate integer ms, s, m, and h units, such as 1h30m.
DENILICENSE_ACCESS_TOKEN_TTL=15m
DENILICENSE_REFRESH_TOKEN_TTL=720h
DENILICENSE_EMAIL_VERIFICATION_TTL=30m
DENILICENSE_PASSWORD_RESET_TTL=30m
DENILICENSE_ACTIVATION_LEASE_TTL=24h
DENILICENSE_SHUTDOWN_TIMEOUT=15s

# Development and test default to true; production defaults to false. Prefer a
# separate `denilicense migrate` deployment job in production.
DENILICENSE_AUTO_MIGRATE=true

# Generate a separate online signing key:
#   denilic keygen --purpose activation --private secrets/activation.key.json --public secrets/activation.public.json
DENILICENSE_ACTIVATION_ISSUER=http://127.0.0.1:8080
DENILICENSE_ACTIVATION_KEY_FILE=secrets/activation.key.json

# Production requires a separately mounted passphrase file. The environment
# value is accepted only outside production and is useful for local automation.
DENILICENSE_ACTIVATION_KEY_PASSPHRASE_FILE=secrets/activation.passphrase
# DENILICENSE_ACTIVATION_KEY_PASSPHRASE=REPLACE_WITH_LOCAL_DEVELOPMENT_PASSPHRASE

# Comma-separated public-key documents for a prepublished successor and prior
# keys retained until every lease they signed has expired.
# DENILICENSE_ACTIVATION_VERIFICATION_KEY_FILES=secrets/activation.next.public.json,secrets/activation.previous.public.json

# Required in production for account recovery, and for open registration unless
# development token exposure is explicitly enabled. Production URLs use HTTPS.
# DENILICENSE_PUBLIC_APP_URL=https://licenses.example.com
# DENILICENSE_EMAIL_WEBHOOK_URL=https://mailer.internal.example/v1/send
# DENILICENSE_EMAIL_WEBHOOK_BEARER=REPLACE_WITH_AT_LEAST_32_CHARACTERS

# Non-interactive administrative automation only. Prefer an injected secret;
# never commit this value or place it directly in a shell command.
# DENILICENSE_BOOTSTRAP_PASSWORD=REPLACE_WITH_PASSWORD_MANAGER_VALUE

# Offline CLI automation only. Prefer an interactive prompt or isolated secret
# injection on the disconnected issuer workstation.
# DENILICENSE_KEY_PASSPHRASE=REPLACE_WITH_OFFLINE_KEY_PASSPHRASE
